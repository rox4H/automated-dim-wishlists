{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rox4H/destiny-2-weapon-database/main/schemas/weapon-perk-pool.schema.json",
  "title": "Weapon perk pool",
  "description": "The perk options attached to a specific weapon definition/version. This is factual item data, not a recommendation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "weapon_id",
    "weapon_hash",
    "version_label",
    "pool_status",
    "verification_status",
    "last_verified",
    "slots",
    "notes"
  ],
  "properties": {
    "weapon_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*_s[0-9]+(?:-[0-9]+)?$",
      "description": "Canonical underscore-suffixed ID of a specific record in public.d2wd_weapons. It must match that weapon-version ID exactly."
    },
    "weapon_hash": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Exact weapon item hash this pool describes, where known."
    },
    "version_label": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Optional human-readable version or sandbox label, e.g. the original release/season."
    },
    "pool_status": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "description": "Completeness of this captured pool; independent of evidence verification status."
    },
    "verification_status": {
      "enum": [
        "unverified",
        "verified"
      ]
    },
    "last_verified": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "selection_mode",
          "perk_ids",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable within this pool, e.g. trait-1, trait-2, barrel, magazine."
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "selection_mode": {
            "enum": [
              "choose-one",
              "fixed",
              "multi-select",
              "unknown"
            ]
          },
          "perk_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "description": "Alternative perk IDs that can roll in this single socket/slot. Multiple IDs are expected for choice slots; do not create one slot per alternative. IDs reference public.d2wd_perks. May be empty only when the slot has not been researched; explain this in notes."
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "description": "Optional. Reviewed pools may omit it and record provenance in notes instead.",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "claim",
        "accessed"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "accessed": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "verified"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "properties": {
          "last_verified": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  ]
}
